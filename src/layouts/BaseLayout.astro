---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Your guide into Warhammer 40,000. Find your army, learn to build, paint, and play." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="b_PgyryjWZS5RV2eq58GNUzSiEop7ocwn3Rx5bH5V1o" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={`${title} | Grimdark Primer`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grimdark Primer" />
    <title>{title} | Grimdark Primer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#111113] text-[#f0ede8] font-sans antialiased min-h-screen flex flex-col">
    <nav class="border-b border-[#2a2a35] px-6 py-4">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="font-display text-lg font-semibold text-[#c9a84c] tracking-wide hover:text-[#dfc070] transition-colors">
          Grimdark Primer
        </a>
        <div class="flex items-center gap-6 text-sm text-[#8a8590]">
          <a href="/quiz/" class="hover:text-[#f0ede8] transition-colors">Army Quiz</a>
          <a href="/factions/" class="hover:text-[#f0ede8] transition-colors">Factions</a>
          <a href="/building/" class="hover:text-[#f0ede8] transition-colors">Building</a>
          <a href="/painting/" class="hover:text-[#f0ede8] transition-colors">Painting</a>
          <a href="/basing/" class="hover:text-[#f0ede8] transition-colors">Basing</a>
          <a href="/getting-started/" class="hover:text-[#f0ede8] transition-colors">How to Play</a>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[#2a2a35] px-6 py-8 mt-16">
      <div class="max-w-5xl mx-auto text-center text-sm text-[#4a4855]">
        <p>Grimdark Primer is an independent guide. Not affiliated with Games Workshop.</p>
        <p class="mt-1">Some links are affiliate links — we earn a small commission at no extra cost to you.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .font-display {
    font-family: 'Cinzel', serif;
  }
  .font-sans {
    font-family: 'Inter', sans-serif;
  }
</style>
