---
import '../styles/global.css';
import { factionMeta, relatedFactions } from '../data/factions.js';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Your guide into Warhammer 40,000. Find your army, learn to build, paint, and play." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Bump this whenever the site gets a content/accuracy review pass.
const lastReviewed = "August 2026";

// Detect a faction detail page from the URL (e.g. /factions/necrons/) so we can
// auto-render the "Where to next?" cross-link band without editing all 22 pages.
const factionMatch = Astro.url.pathname.match(/^\/factions\/([^/]+)\/?$/);
const factionSlug = factionMatch && factionMeta[factionMatch[1]] ? factionMatch[1] : null;
const related = factionSlug ? (relatedFactions[factionSlug] || []) : [];
const hobbyLinks = [
  { href: '/building/', emoji: '🔧', label: 'Building guide' },
  { href: '/painting/', emoji: '🎨', label: 'Painting guide' },
  { href: '/basing/', emoji: '🏔️', label: 'Basing guide' },
  { href: '/getting-started/', emoji: '⚔️', label: 'How to play' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="b_PgyryjWZS5RV2eq58GNUzSiEop7ocwn3Rx5bH5V1o" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={`${title} | Grimdark Primer`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grimdark Primer" />
    <title>{title} | Grimdark Primer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#111113] text-[#f0ede8] font-sans antialiased min-h-screen flex flex-col">
    <nav class="border-b border-[#2a2a35] px-6 py-4">
      <div class="max-w-5xl mx-auto">
        <!-- CSS-only mobile toggle: no JS needed; resets on page navigation -->
        <input type="checkbox" id="nav-toggle" class="peer sr-only" />
        <div class="flex items-center justify-between">
          <a href="/" class="font-display text-lg font-semibold text-[#c9a84c] tracking-wide hover:text-[#dfc070] transition-colors">
            Grimdark Primer
          </a>
          <!-- Desktop links -->
          <div class="hidden sm:flex items-center gap-6 text-sm text-[#8a8590]">
            <a href="/what-is-warhammer/" class="hover:text-[#f0ede8] transition-colors">Start Here</a>
            <a href="/quiz/" class="hover:text-[#f0ede8] transition-colors">Army Quiz</a>
            <a href="/factions/" class="hover:text-[#f0ede8] transition-colors">Factions</a>
            <a href="/building/" class="hover:text-[#f0ede8] transition-colors">Building</a>
            <a href="/painting/" class="hover:text-[#f0ede8] transition-colors">Painting</a>
            <a href="/basing/" class="hover:text-[#f0ede8] transition-colors">Basing</a>
            <a href="/getting-started/" class="hover:text-[#f0ede8] transition-colors">How to Play</a>
          </div>
          <!-- Mobile hamburger -->
          <label for="nav-toggle" class="sm:hidden cursor-pointer text-[#8a8590] hover:text-[#f0ede8] transition-colors -mr-1 p-1" aria-label="Toggle navigation menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </label>
        </div>
        <!-- Mobile dropdown (revealed via peer-checked) -->
        <div class="hidden peer-checked:flex sm:hidden flex-col mt-4 text-sm text-[#8a8590]">
          <a href="/what-is-warhammer/" class="py-2 hover:text-[#f0ede8] transition-colors">Start Here</a>
          <a href="/quiz/" class="py-2 hover:text-[#f0ede8] transition-colors">Army Quiz</a>
          <a href="/factions/" class="py-2 hover:text-[#f0ede8] transition-colors">Factions</a>
          <a href="/building/" class="py-2 hover:text-[#f0ede8] transition-colors">Building</a>
          <a href="/painting/" class="py-2 hover:text-[#f0ede8] transition-colors">Painting</a>
          <a href="/basing/" class="py-2 hover:text-[#f0ede8] transition-colors">Basing</a>
          <a href="/getting-started/" class="py-2 hover:text-[#f0ede8] transition-colors">How to Play</a>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    {factionSlug && (
      <section class="border-t border-[#2a2a35] bg-[#0d0d0f] px-6 py-12">
        <div class="max-w-4xl mx-auto">
          <h2 class="font-display text-xl font-semibold text-[#c9a84c] mb-6">Where to next?</h2>
          <div class="grid sm:grid-cols-2 gap-8">
            <div>
              <p class="text-xs uppercase tracking-wide text-[#4a4855] font-display mb-3">Learn the hobby</p>
              <div class="flex flex-col gap-2 text-sm">
                {hobbyLinks.map(l => (
                  <a href={l.href} class="text-[#b8b4c0] hover:text-[#c9a84c] transition-colors">
                    <span class="mr-2">{l.emoji}</span>{l.label}
                  </a>
                ))}
              </div>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wide text-[#4a4855] font-display mb-3">Similar armies</p>
              <div class="flex flex-col gap-2 text-sm">
                {related.map(s => (
                  <a href={`/factions/${s}/`} class="text-[#b8b4c0] hover:text-[#c9a84c] transition-colors">
                    <span class="mr-2">{factionMeta[s].emoji}</span>{factionMeta[s].name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <footer class="border-t border-[#2a2a35] px-6 py-10 mt-16">
      <div class="max-w-5xl mx-auto">
        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-[#8a8590] mb-6">
          <a href="/what-is-warhammer/" class="hover:text-[#f0ede8] transition-colors">Start Here</a>
          <a href="/quiz/" class="hover:text-[#f0ede8] transition-colors">Army Quiz</a>
          <a href="/factions/" class="hover:text-[#f0ede8] transition-colors">Factions</a>
          <a href="/building/" class="hover:text-[#f0ede8] transition-colors">Building</a>
          <a href="/painting/" class="hover:text-[#f0ede8] transition-colors">Painting</a>
          <a href="/basing/" class="hover:text-[#f0ede8] transition-colors">Basing</a>
          <a href="/getting-started/" class="hover:text-[#f0ede8] transition-colors">How to Play</a>
        </nav>
        <div class="text-center text-sm text-[#4a4855] space-y-1">
          <p>Grimdark Primer is an independent guide. Not affiliated with Games Workshop.</p>
          <p>Some links are affiliate links — we earn a small commission at no extra cost to you.</p>
          <p>Content last reviewed {lastReviewed}. Rules and prices change between editions — always confirm against official sources.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .font-display {
    font-family: 'Cinzel', serif;
  }
  .font-sans {
    font-family: 'Inter', sans-serif;
  }
</style>
